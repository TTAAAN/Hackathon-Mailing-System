# =============================================================================
# ZeptoMail API Configuration
# =============================================================================

# Your ZeptoMail Send Mail Token (zoho-enczapikey or raw token)
# Find this in ZeptoMail Console -> Mail Agents -> Setup Info -> Send Mail Token
ZEPTO_MAIL_TOKEN="TOKEN"

# Data center region: "us", "eu", "in", "au", "ca", or "sa" (Default: "us")
ZEPTO_REGION="us"

# =============================================================================
# Sender & Routing Configuration
# =============================================================================

# Verified sender email associated with your ZeptoMail Mail Agent domain
ZEPTO_SENDER_EMAIL="result@mail.itm-hackathon.tech"

# Support / Reply-To email where attendee responses will be delivered
ZEPTO_REPLY_TO_EMAIL="support@itm-hackathon.tech"